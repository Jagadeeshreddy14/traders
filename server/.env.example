NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
MONGODB_URI=mongodb://localhost:27017/paven_traders
JWT_ACCESS_SECRET=paven_traders_access_secret_key_minimum_32_characters_super_secure!
JWT_REFRESH_SECRET=paven_traders_refresh_secret_key_minimum_32_characters_super_secure!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5174
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10

INITIAL_ADMIN_NAME="Store Administrator"
INITIAL_ADMIN_EMAIL=admin@paventraders.com
INITIAL_ADMIN_PASSWORD=Admin@SecurePassword123!
INITIAL_ADMIN_PHONE="+919876543210"

# Phase 4: PhonePe Payment Gateway configuration
PHONEPE_ENV=SANDBOX
PHONEPE_CLIENT_ID=your_phonepe_client_id
PHONEPE_CLIENT_SECRET=your_phonepe_client_secret
PHONEPE_CLIENT_VERSION=1
PHONEPE_MERCHANT_ID=your_phonepe_merchant_id
PHONEPE_WEBHOOK_USERNAME=your_webhook_username
PHONEPE_WEBHOOK_PASSWORD=your_webhook_password
PHONEPE_REDIRECT_URL=http://localhost:5173/payment/callback

# Phase 4: Store & Inventory Reservation Configuration
INVENTORY_RESERVATION_EXPIRY_MINUTES=15
STORE_NAME="Paven Traders"
STORE_PHONE="+91 98765 43210"
STORE_EMAIL="support@paventraders.com"
STORE_ADDRESS="Shop #4, Paven Complex, Main Road, City Center - 500001"
