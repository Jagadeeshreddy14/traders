# ==============================================================================
# Paven Traders - Environment Configuration Template
# ==============================================================================
# NOTE: Copy this file to .env in each corresponding workspace or root as needed.
# NEVER commit real production secrets or credentials to source control!

# ------------------------------------------------------------------------------
# Server Configuration (server/.env)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB Atlas Connection
# Replace with your MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb+srv://jagadeesh:8074563501@cluster0.ur44l.mongodb.net/paven_traders

# JSON Web Tokens
# Generate secure random strings for production (e.g., openssl rand -base64 48)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters_long_for_security
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_long_for_security
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5174

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Initial Admin Seeding (Used by npm run seed:admin)
INITIAL_ADMIN_NAME="Store Administrator"
INITIAL_ADMIN_EMAIL=admin@paventraders.com
INITIAL_ADMIN_PASSWORD=Admin@SecurePassword123!
INITIAL_ADMIN_PHONE="+919876543210"

# ------------------------------------------------------------------------------
# Customer Web Client (apps/customer-web/.env)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_NAME="Paven Traders"

# ------------------------------------------------------------------------------
# Admin Web Client (apps/admin-web/.env)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_NAME="Paven Traders Admin"

# ------------------------------------------------------------------------------
# Mobile Client (apps/mobile/.env)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
